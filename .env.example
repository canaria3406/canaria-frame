FRAME_R2_BUCKET=canaria-frame-originals
FRAME_PAGES_PROJECT=canaria-frame

# For the restricted API token setup, copy this file to .env and set both values.
# Use a token scoped to this account with Pages Write, Workers R2 Storage Write,
# and Account Analytics Read. See the README for the dashboard steps.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Maximum estimated size of this Standard bucket after adding the upload, in bytes.
# Reduce this limit if the same Cloudflare account uses other R2 buckets.
# FRAME_R2_MAX_BYTES=8000000000
